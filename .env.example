NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://2fa:2fa@localhost:5432/2fa_lab

JWT_ACCESS_SECRET=change_this_access_secret
JWT_MFA_SECRET=change_this_mfa_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_MFA_EXPIRES_IN=5m

MFA_ISSUER=2FA-Lab

BCRYPT_ROUNDS=12

MFA_ENCRYPTION_KEY=

# SMTP / Mailtrap
# SMTP_HOST, SMTP_PORT, SMTP_USER e SMTP_PASSWORD devem ser copiados das
# credenciais SMTP fornecidas pelo ambiente de testes do Mailtrap.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="2FA Lab <no-reply@2fa.local>"

# Email OTP
EMAIL_OTP_LENGTH=6
EMAIL_OTP_EXPIRES_MINUTES=5
EMAIL_OTP_MAX_ATTEMPTS=5

# Painel de testes: URL da API do Mailpit. Usado por GET /auth/lab/mail.
MAILPIT_API_URL=http://127.0.0.1:8025

# SEGURANCA: SMTP_PASSWORD e uma credencial secreta.
# Nunca fazer commit, nunca registrar em log, nunca expor no Swagger.
